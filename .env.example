# Compose
# 这里必须填写一个已经存在的外部 Docker network，compose 不会帮你创建它。
EXTERNAL_NETWORK=project-v2-network
FRONTEND_PORT=80
BACKEND_IMAGE=crpi-oygnku9mfq22z345.cn-guangzhou.personal.cr.aliyuncs.com/yykpms/project-v2-backend:latest
FRONTEND_IMAGE=crpi-oygnku9mfq22z345.cn-guangzhou.personal.cr.aliyuncs.com/yykpms/project-v2-frontend:latest

# Backend
BACKEND_PORT=3000
APP_PORT=3000
APP_DEBUG_PORT=9229
JWT_SECRET=change-me-in-production
SYSTEM_MENU_SYNC_ON_BOOT=false

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=psd2
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_SYNCHRONIZE=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# Upload volume
UPLOAD_VOLUME=upload
